{
  "name": "opencode-openai-multi-account",
  "version": "0.1.0",
  "description": "OpenAI account usage sidebar and native account actions for OpenCode v2",
  "private": true,
  "type": "module",
  "files": ["src", "dist", "scripts"],
  "exports": {
    ".": {
      "import": "./src/plugin/server.ts"
    },
    "./tui": {
      "import": "./src/plugin/tui/index.tsx"
    }
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "test:smoke": "npm run build && node scripts/smoke-v2.mjs",
    "check": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode/client": "2.2.6",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "solid-js": "1.9.17",
    "@types/node": "^22.15.29",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.1 <0.9",
    "@opentui/solid": ">=0.8.1 <0.9",
    "solid-js": "^1.9.17"
  }
}
